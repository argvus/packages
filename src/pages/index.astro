---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDirectoryIndex } from '../lib/directory'

const index = getDirectoryIndex('')
---

<BaseLayout
  title="Argvus Packages"
  titlePt="Pacotes Argvus"
  descriptionPt="Repositórios binários do Argvus Linux. Os pacotes Arch Linux estão disponíveis agora; os diretórios Debian e RPM estão reservados para futuros alvos de empacotamento."
>
  <section class="packages-hero">
    <div class="container">
      <span class="eyebrow" data-i18n="packageRepositories">Package repositories</span>
      <h1 data-i18n="rootIndex">Index of /packages/</h1>
      <p class="lead">
        <span data-i18n="rootLead">Binary repositories for Argvus Linux. Arch Linux packages are available now;
        Debian and RPM directories are reserved for future packaging targets.</span>
      </p>
    </div>
  </section>

  <section class="directory-section">
    <div class="container">
      <div class="repo-note">
        <div>
            <h2 data-i18n="pacman">Pacman</h2>
            <p data-i18n="pacmanLead">Install the Argvus signing key, then add this repository to /etc/pacman.conf or include it from /etc/pacman.d/argvus.conf.</p>
        </div>
        <pre><code>curl -fsSLo /tmp/argvus.gpg https://argvus.github.io/packages/arch/argvus.gpg
sudo pacman-key --add /tmp/argvus.gpg
ARGVUS_KEY="$(gpg --show-keys --with-colons /tmp/argvus.gpg | grep '^pub:' | head -n1 | cut -d: -f5)"
sudo pacman-key --lsign-key "$ARGVUS_KEY"

[argvus]
SigLevel = Required TrustedOnly
Server = https://argvus.github.io/packages/arch/$arch

[argvus-extras]
SigLevel = Required TrustedOnly
Server = https://argvus.github.io/packages/arch/extras/$arch</code></pre>
      </div>

      <div class="directory-shell">
        <div class="directory-title">
          <h2 data-i18n="rootIndex">Index of /packages/</h2>
        </div>
        <table class="directory-table">
          <thead>
            <tr>
              <th data-i18n="name">Name</th>
              <th data-i18n="lastModified">Last modified</th>
              <th data-i18n="size">Size</th>
            </tr>
          </thead>
          <tbody>
            {index.entries.map((entry) => (
              <tr>
                <td><a class={`entry-link ${entry.kind}`} href={entry.href}>{entry.name}</a></td>
                <td>{entry.modified}</td>
                <td>{entry.size}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
