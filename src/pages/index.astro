---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDirectoryIndex } from '../lib/directory'

const index = getDirectoryIndex('')
---

<BaseLayout
  title="Argvus Packages"
  titlePt="Pacotes Argvus"
  description="Browse the official ARGVUS Arch Linux repository, including signed packages and pacman databases."
  descriptionPt="Navegue pelo repositório oficial do ARGVUS para Arch Linux, com pacotes assinados e bases do pacman."
>
  <section class="packages-hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow" data-i18n="packageRepositories">Package repositories</span>
      <h1 data-i18n="rootIndex">Index of /packages/</h1>
      <p class="lead">
        <span data-i18n="rootLead">Browse the official ARGVUS Arch Linux repository, including signed packages and pacman databases.</span>
      </p>
    </div>
  </section>

  <section class="directory-section">
    <div class="container">
      <div class="directory-shell">
        <div class="directory-title">
          <h2 data-i18n="rootIndex">Index of /packages/</h2>
        </div>
        <table class="directory-table">
          <thead>
            <tr>
              <th data-i18n="name">Name</th>
              <th data-i18n="lastModified">Last modified</th>
              <th data-i18n="size">Size</th>
            </tr>
          </thead>
          <tbody>
            {index.entries.map((entry) => (
              <tr>
                <td><a class={`entry-link ${entry.kind}`} href={entry.href}>{entry.name}</a></td>
                <td>{entry.modified}</td>
                <td>{entry.size}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
