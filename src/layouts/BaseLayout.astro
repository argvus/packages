        id: ['Dokumentasi','Navigasi utama','Repositori','Arch Linux','GitHub','Donasi','Paket dihosting di GitHub Pages','Repositori paket resmi untuk lingkungan desktop ARGVUS.','Repositori','Repositori Arch Linux','Sumber daya','Beranda','Komunitas','Kanal resmi','Komunitas global','Komunitas Brasil','Dilisensikan di bawah GPL-3.0','Dikelola oleh William C. Canin','Menu','Ubah tema','Ubah bahasa','Terang','Gelap','Sistem','Repositori paket','Indeks /packages/','Jelajahi repositori Arch Linux resmi ARGVUS, termasuk paket bertanda tangan dan basis data pacman.','Nama','Terakhir diubah','Ukuran','Paket Argvus','Jelajahi berkas paket, basis data pacman, tanda tangan, dan arsip biner.','Kesalahan 404','Halaman tidak ditemukan','Periksa URL atau kembali ke indeks paket.','Kembali ke indeks paket'],
        ur: ['دستاویزات','مرکزی نیویگیشن','ریپوزٹری','Arch Linux','GitHub','عطیہ کریں','GitHub Pages پر میزبانی شدہ پیکیجز','ARGVUS ڈیسک ٹاپ ماحول کے لیے سرکاری پیکیج ریپوزٹریز۔','ریپوزٹریز','Arch Linux ریپوزٹری','وسائل','صفحۂ اول','کمیونٹی','سرکاری چینل','عالمی کمیونٹی','برازیلی کمیونٹی','GPL-3.0 کے تحت لائسنس یافتہ','William C. Canin کی نگرانی میں','مینو','تھیم تبدیل کریں','زبان تبدیل کریں','روشن','تاریک','سسٹم','پیکیج ریپوزٹریز','/packages/ اشاریہ','دستخط شدہ پیکیجز اور pacman ڈیٹا بیس سمیت سرکاری ARGVUS Arch Linux ریپوزٹری دیکھیں۔','نام','آخری ترمیم','حجم','Argvus پیکیجز','پیکیج فائلیں، pacman ڈیٹا بیس، دستخط اور بائنری آرکائیوز دیکھیں۔','404 خرابی','صفحہ نہیں ملا','URL چیک کریں یا پیکیج اشاریے پر واپس جائیں۔','پیکیج اشاریے پر واپس جائیں'],
        tr: ['Belgeler','Ana gezinme','Depo','Arch Linux','GitHub','Bağış yap','GitHub Pages üzerinde barındırılan paketler','ARGVUS masaüstü ortamının resmi paket depoları.','Depolar','Arch Linux deposu','Kaynaklar','Ana sayfa','Topluluk','Resmî kanal','Küresel topluluk','Brezilya topluluğu','GPL-3.0 kapsamında lisanslı','William C. Canin tarafından yürütülüyor','Menü','Temayı değiştir','Dili değiştir','Açık','Koyu','Sistem','Paket depoları','/packages/ dizini','İmzalı paketler ve pacman veritabanları dahil resmi ARGVUS Arch Linux deposuna göz atın.','Ad','Son değiştirilme','Boyut','Argvus Paketleri','Paket dosyalarına, pacman veritabanlarına, imzalara ve ikili arşivlere göz atın.','404 hatası','Sayfa bulunamadı','URL’yi kontrol edin veya paket dizinine dönün.','Paket dizinine dön'],
      }
      for (const [language, values] of Object.entries(localizedValues)) {
        languageTranslations[language] = Object.fromEntries(translationKeys.map((key, index) => [key, values[index]]))
      }
      languageTranslations['pt-br'] = languageTranslations.pt
      languageTranslations['pt-pt'] = languageTranslations.pt
      const LANGUAGE_KEY = 'argvus-packages-language'

      const currentTheme = () => {
        const stored = localStorage.getItem(STORAGE_KEY)
        return stored === 'light' || stored === 'dark'
          ? stored
          : media.matches
            ? 'light'
            : 'dark'
      }

      const render = () => {
        const theme = currentTheme()
        root.dataset.theme = theme
        btn.dataset.mode = localStorage.getItem(STORAGE_KEY) ? theme : 'system'
        options.forEach((opt) => {
          opt.setAttribute('aria-checked', String(opt.dataset.themeOption === theme))
        })
      }

      const setTheme = (value) => {
        if (value === 'system') localStorage.removeItem(STORAGE_KEY)
        else localStorage.setItem(STORAGE_KEY, value)
        render()
      }

      const currentLanguage = () => {
        const stored = localStorage.getItem(LANGUAGE_KEY)
        if (stored && languageOptions.some((option) => option.dataset.languageOption === stored)) return stored
        const browserLanguage = navigator.language.toLowerCase().split('-')[0]
        return languageOptions.some((option) => option.dataset.languageOption === browserLanguage) ? browserLanguage : 'en'
      }

      const setLanguage = (language) => {
        const translationLanguage = language === 'pt-br' || language === 'pt-pt' ? 'pt' : language
        const translations = languageTranslations[translationLanguage] || languageTranslations.en
        localStorage.setItem(LANGUAGE_KEY, language)
        document.documentElement.lang = language === 'pt-br' ? 'pt-BR' : language === 'pt-pt' ? 'pt-PT' : language
        if (translationLanguage === 'en' || translationLanguage === 'pt') {
          document.title = document.documentElement.dataset[`title${translationLanguage === 'pt' ? 'Pt' : 'En'}`]
          document.querySelector('[data-page-description]').content =
            document.documentElement.dataset[`description${translationLanguage === 'pt' ? 'Pt' : 'En'}`]
        }
        languageCurrent.textContent = languageFlags[language]
        languageOptions.forEach((option) => {
          option.setAttribute('aria-current', String(option.dataset.languageOption === language))
        })
        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const key = element.dataset.i18n
          element.textContent = key === 'directoryIndex'
            ? `${translationLanguage === 'pt' ? 'Índice de' : translationLanguage === 'en' ? 'Index of' : translations.rootIndex.replace('/packages/', '').trim()} ${element.dataset.directoryPath}`
            : translations[key] || languageTranslations.en[key]
        })
        document.querySelectorAll('[data-i18n-aria]').forEach((element) => {
          element.setAttribute('aria-label', translations[element.dataset.i18nAria])
        })
      }

      languageSearch.addEventListener('input', () => {
        const query = languageSearch.value.trim().toLocaleLowerCase()
        let visible = 0
        languageOptions.forEach((option) => {
          const matches = option.dataset.search.toLocaleLowerCase().includes(query)
          option.hidden = !matches
          if (matches) visible += 1
        })
        noLanguageResults.hidden = visible > 0
      })

      setLanguage(currentLanguage())

      btn.addEventListener('click', () => {
        menu.hidden = !menu.hidden
        langMenu.hidden = true
      })

      languageOptions.forEach((option) => {
        option.addEventListener('click', () => {
          setLanguage(option.dataset.languageOption)
          langMenu.hidden = true
        })
      })

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          setTheme(opt.dataset.themeOption)
          menu.hidden = true
        })
      })

      langBtn.addEventListener('click', () => {
        langMenu.hidden = !langMenu.hidden
        menu.hidden = true
        if (!langMenu.hidden) languageSearch.focus()
      })

      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-theme-toggle]')) menu.hidden = true
        if (!e.target.closest('[data-lang-toggle]')) langMenu.hidden = true
        if (!e.target.closest('#site-nav-links') && !e.target.closest('[data-nav-menu]')) setMobileMenu(false)
        if (!e.target.closest('[data-nav-dropdown]')) {
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((dropdownMenu) => {
            dropdownMenu.hidden = true
          })
        }
      })

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          menu.hidden = true
          langMenu.hidden = true
          setMobileMenu(false)
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((dropdownMenu) => {
            dropdownMenu.hidden = true
          })
        }
      })

      document.querySelectorAll('[data-nav-dropdown-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation()
          const dropdownMenu = trigger.nextElementSibling
          dropdownMenu.hidden = !dropdownMenu.hidden
        })
      })

      const setMobileMenu = (open) => {
        siteNav.toggleAttribute('data-menu-open', open)
        mobileButton.setAttribute('aria-expanded', String(open))
      }
      mobileButton.addEventListener('click', (event) => {
        event.stopPropagation()
        setMobileMenu(!siteNav.hasAttribute('data-menu-open'))
      })
      siteNav.querySelectorAll('.nav-links a').forEach((anchor) => {
        anchor.addEventListener('click', () => setMobileMenu(false))
      })
      const header = document.querySelector('.site-header')
      const markScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 8)
      window.addEventListener('scroll', markScrolled, { passive: true })
      markScrolled()

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const hasHoverPointer = window.matchMedia('(hover: hover)').matches
      if (hasHoverPointer && !reduceMotion) {
        document.body.addEventListener('pointermove', (event) => {
          document.body.style.setProperty('--pointer-x', `${event.clientX}px`)
          document.body.style.setProperty('--pointer-y', `${event.clientY}px`)
        })
        document.querySelectorAll('.packages-hero').forEach((hero) => {
          hero.addEventListener('pointermove', (event) => {
            const rect = hero.getBoundingClientRect()
            hero.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width - 0.5).toFixed(3)}`)
            hero.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height - 0.5).toFixed(3)}`)
          })
        })
      }

      media.addEventListener('change', render)
      render()
      setLanguage(currentLanguage())
    </script>
  </body>
</html>
