---
import ThemeToggle from '../components/ThemeToggle.astro'
import '../styles/global.css'
import '../styles/site-identity.css'
import fs from 'node:fs'
import { resolve } from 'node:path'
import siteConfig from '../site-config.json'

const { version } = JSON.parse(
  fs.readFileSync(resolve(process.cwd(), 'package.json'), 'utf8'),
)
const isBeta = version.startsWith('0.')

interface Props {
  title: string
  titlePt?: string
  description?: string
  descriptionPt?: string
}

const {
  title,
  titlePt = title,
  description = 'Browse the official ARGVUS Arch Linux repository, including signed packages and pacman databases.',
  descriptionPt = 'Navegue pelo repositório oficial do ARGVUS para Arch Linux, com pacotes assinados e bases do pacman.',
} = Astro.props
const base = import.meta.env.BASE_URL
const siteUrl = 'https://argvus.github.io'
const pageUrl = Astro.url.href
const githubOrgUrl = 'https://github.com/orgs/argvus'
const logotypeUrl = `${base}brand/argvus-logo.svg`
const argvusWordmarkUrl = `${base}brand/argvus-wordmark.svg`
const keywords =
  'argvus, argvus linux, hyprland, wayland, arch linux packages, pacman repository, argvus-appearance, argvus-greeter, argvus-session, argvus-removable-devices, signed packages, linux desktop'
const contributionConfig = siteConfig.contributionLinks
const contributionEnabled = contributionConfig.enable
---

<!doctype html>
<html lang="en" data-theme="dark" data-title-en={title} data-title-pt={titlePt} data-description-en={description} data-description-pt={descriptionPt}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} data-page-description />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Argvus Packages" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${siteUrl}${base}favicon.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${base}favicon.png`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'DataCatalog',
      name: 'Argvus Packages',
      url: pageUrl,
      description,
      keywords,
      creator: {
        '@type': 'Organization',
        name: 'Argvus',
        url: githubOrgUrl,
      },
    })} />
    <script is:inline>
      ;(function () {
        var key = 'starlight-theme'
        var stored = localStorage.getItem(key)
        var light = matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : light
              ? 'light'
              : 'dark'
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="https://argvus.github.io/">
          <img class="brand-logotype" src={logotypeUrl} alt="" width={48} height={48} />
          <img class="brand-wordmark" src={argvusWordmarkUrl} alt="ARGVUS" width={178} height={20} />
          {isBeta && <span class="beta-badge">Beta</span>}
        </a>
        <nav class="site-nav" aria-label="Main navigation" data-i18n-aria="navAria" data-site-nav>
          <div class="nav-links" id="site-nav-links">
            <a class="nav-link" href="https://argvus.github.io/docs/introduction/"><i class="fa-solid fa-book-open"></i><span data-i18n="documentation">Documentation</span></a>
            <div class="nav-dropdown" data-nav-dropdown>
              <button class="nav-link nav-dropdown-trigger" type="button" data-nav-dropdown-trigger>
                <i class="fa-solid fa-cube"></i>
                <span data-i18n="repository">Repository</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <div class="nav-dropdown-menu" data-nav-dropdown-menu hidden>
                <a class="nav-dropdown-item" href={`${base}arch/`}><i class="fa-brands fa-linux"></i><span data-i18n="archLinux">Arch Linux</span></a>
              </div>
            </div>
            <a class="nav-link" href={githubOrgUrl}><i class="fa-brands fa-github"></i><span data-i18n="github">GitHub</span></a>
            {contributionEnabled && <a class="nav-link nav-link-donate" href="https://argvus.github.io/#support"><i class="fa-solid fa-heart"></i><span data-i18n="donate">Donate</span></a>}
          </div>
          <div class="lang-toggle" data-lang-toggle>
            <button
              class="lang-toggle-btn"
              type="button"
              data-lang-current
              aria-label="Change language"
              data-i18n-aria="languageAria"
              aria-haspopup="menu"
            >
              <span data-language-current aria-hidden="true">🇬🇧</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>

            <div class="lang-toggle-menu" data-lang-menu hidden>
              <label class="lang-search-wrap"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-lang-search aria-label="Search languages…" placeholder="Search languages…" autocomplete="off" /></label>
              <div class="lang-options" data-lang-options>
                <button class="lang-option" type="button" data-language-option="en" data-search="English English en" aria-current="page"><span class="lang-flag">🇬🇧</span>English</button>
                <button class="lang-option" type="button" data-language-option="pt-br" data-search="Portuguese Brazil Português Brasil pt-br"><span class="lang-flag">🇧🇷</span>Português (Brasil)</button>
                <button class="lang-option" type="button" data-language-option="pt-pt" data-search="Portuguese Portugal Português pt-pt"><span class="lang-flag">🇵🇹</span>Português (Portugal)</button>
                <button class="lang-option" type="button" data-language-option="es" data-search="Spanish Español es"><span class="lang-flag">🇪🇸</span>Español</button>
                <button class="lang-option" type="button" data-language-option="fr" data-search="French Français fr"><span class="lang-flag">🇫🇷</span>Français</button>
                <button class="lang-option" type="button" data-language-option="it" data-search="Italian Italiano it"><span class="lang-flag">🇮🇹</span>Italiano</button>
                <button class="lang-option" type="button" data-language-option="zh" data-search="Chinese 中文 zh"><span class="lang-flag">🇨🇳</span>中文</button>
                <button class="lang-option" type="button" data-language-option="ja" data-search="Japanese 日本語 ja"><span class="lang-flag">🇯🇵</span>日本語</button>
                <button class="lang-option" type="button" data-language-option="de" data-search="German Deutsch de"><span class="lang-flag">🇩🇪</span>Deutsch</button>
                <button class="lang-option" type="button" data-language-option="ru" data-search="Russian Русский ru"><span class="lang-flag">🇷🇺</span>Русский</button>
                <button class="lang-option" type="button" data-language-option="ko" data-search="Korean 한국어 ko"><span class="lang-flag">🇰🇷</span>한국어</button>
                <button class="lang-option" type="button" data-language-option="hi" data-search="Hindi हिन्दी hi"><span class="lang-flag">🇮🇳</span>हिन्दी</button>
                <button class="lang-option" type="button" data-language-option="ar" data-search="Arabic العربية ar"><span class="lang-flag">🇸🇦</span>العربية</button>
                <button class="lang-option" type="button" data-language-option="bn" data-search="Bengali বাংলা bn"><span class="lang-flag">🇧🇩</span>বাংলা</button>
                <button class="lang-option" type="button" data-language-option="id" data-search="Indonesian Bahasa Indonesia id"><span class="lang-flag">🇮🇩</span>Bahasa Indonesia</button>
                <button class="lang-option" type="button" data-language-option="ur" data-search="Urdu اردو ur"><span class="lang-flag">🇵🇰</span>اردو</button>
                <button class="lang-option" type="button" data-language-option="vi" data-search="Vietnamese Tiếng Việt vi"><span class="lang-flag">🇻🇳</span>Tiếng Việt</button>
                <button class="lang-option" type="button" data-language-option="tr" data-search="Turkish Türkçe tr"><span class="lang-flag">🇹🇷</span>Türkçe</button>
                <p class="lang-no-results" data-lang-no-results hidden>No languages found.</p>
              </div>
            </div>
          </div>
          <ThemeToggle />
          <button class="nav-menu-btn" type="button" aria-controls="site-nav-links" aria-expanded="false" aria-label="Menu" data-i18n-aria="navMenu" data-nav-menu>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <a class="brand" href="https://argvus.github.io/">
              <img class="brand-logotype" src={logotypeUrl} alt="" width={48} height={48} />
              <img class="brand-wordmark" src={argvusWordmarkUrl} alt="ARGVUS" width={178} height={20} />
            </a>
            <p data-i18n="footerTagline">Official package repositories for the ARGVUS desktop environment.</p>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footerRepositories">Repositories</h4>
            <ul><li><a href={`${base}arch/`} data-i18n="archLinuxRepository">Arch Linux Repository</a></li></ul>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footerResources">Resources</h4>
            <ul>
              <li><a href="https://argvus.github.io/docs/introduction/" data-i18n="documentation">Documentation</a></li>
              <li><a href={githubOrgUrl} data-i18n="github">GitHub</a></li>
              <li><a href="https://argvus.github.io/" data-i18n="footerHome">Home</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footerCommunity">Community</h4>
            <ul>
              <li><a href="https://t.me/argvusdesktop" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-telegram"></i><span data-i18n="footerOfficialChannel">Official channel</span></a></li>
              <li><a href="https://t.me/argvuscommunity" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-telegram"></i><span data-i18n="footerGlobalCommunity">Global community</span></a></li>
              <li><a href="https://t.me/argvuscommunity_br" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-telegram"></i><span data-i18n="footerBrazilCommunity">Brazilian community</span></a></li>
            </ul>
          </div>
        </div>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} ARGVUS</span><span aria-hidden="true">·</span>
          <a href="https://github.com/argvus/argvus/blob/main/LICENSE" data-i18n="footerLicense">Licensed under GPL-3.0</a><span aria-hidden="true">·</span>
          <a href="https://github.com/williamcanin" target="_blank" rel="noopener noreferrer" data-i18n="footerMaintainer">Maintained by William C. Canin</a>
          <span class="footer-feedback" data-i18n="packagesHosted">Packages hosted on GitHub Pages</span>
        </div>
      </div>
    </footer>

    <script>
      const STORAGE_KEY = 'starlight-theme'
      const root = document.documentElement
      const media = window.matchMedia('(prefers-color-scheme: light)')
      const btn = document.querySelector('[data-theme-current]')
      const menu = document.querySelector('[data-theme-menu]')
      const options = Array.from(document.querySelectorAll('[data-theme-option]'))
      const langBtn = document.querySelector('[data-lang-current]')
      const langMenu = document.querySelector('[data-lang-menu]')
      const languageCurrent = document.querySelector('[data-language-current]')
      const languageOptions = Array.from(document.querySelectorAll('[data-language-option]'))
      const languageSearch = document.querySelector('[data-lang-search]')
      const noLanguageResults = document.querySelector('[data-lang-no-results]')
      const languageFlags = { en: '🇬🇧', 'pt-br': '🇧🇷', 'pt-pt': '🇵🇹', es: '🇪🇸', fr: '🇫🇷', it: '🇮🇹', zh: '🇨🇳', ja: '🇯🇵', de: '🇩🇪', ru: '🇷🇺', ko: '🇰🇷', hi: '🇮🇳', ar: '🇸🇦', bn: '🇧🇩', id: '🇮🇩', ur: '🇵🇰', vi: '🇻🇳', tr: '🇹🇷' }
      const siteNav = document.querySelector('[data-site-nav]')
      const mobileButton = document.querySelector('[data-nav-menu]')
      const languageTranslations = {
        en: {
