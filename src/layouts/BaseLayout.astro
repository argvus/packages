---
import ThemeToggle from '../components/ThemeToggle.astro'
import '../styles/global.css'
import '../styles/site-identity.css'
import fs from 'node:fs'
import { resolve } from 'node:path'
import siteConfig from '../site-config.json'

const { version } = JSON.parse(
  fs.readFileSync(resolve(process.cwd(), 'package.json'), 'utf8'),
)
const isBeta = version.startsWith('0.')

interface Props {
  title: string
  titlePt?: string
  description?: string
  descriptionPt?: string
}

const {
  title,
  titlePt = title,
  description = 'Browse the official ARGVUS Arch Linux repository, including signed packages and pacman databases.',
  descriptionPt = 'Navegue pelo repositório oficial do ARGVUS para Arch Linux, com pacotes assinados e bases do pacman.',
} = Astro.props
const base = import.meta.env.BASE_URL
const siteUrl = 'https://argvus.github.io'
const pageUrl = Astro.url.href
const githubOrgUrl = 'https://github.com/orgs/argvus'
const logotypeUrl = `${base}brand/argvus-logo.svg`
const argvusWordmarkUrl = `${base}brand/argvus-wordmark.svg`
const keywords =
  'argvus, argvus linux, hyprland, wayland, arch linux packages, pacman repository, argvus-appearance, argvus-greeter, argvus-session, argvus-removable-devices, signed packages, linux desktop'
const contributionConfig = siteConfig.contributionLinks
const contributionEnabled = contributionConfig.enable
---

<!doctype html>
<html lang="en" data-theme="dark" data-title-en={title} data-title-pt={titlePt} data-description-en={description} data-description-pt={descriptionPt}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} data-page-description />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Argvus Packages" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${siteUrl}${base}favicon.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${base}favicon.png`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'DataCatalog',
      name: 'Argvus Packages',
      url: pageUrl,
      description,
      keywords,
      creator: {
        '@type': 'Organization',
        name: 'Argvus',
        url: githubOrgUrl,
      },
    })} />
    <script is:inline>
      ;(function () {
        var key = 'starlight-theme'
        var stored = localStorage.getItem(key)
        var light = matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : light
              ? 'light'
              : 'dark'
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="https://argvus.github.io/">
          <img class="brand-logotype" src={logotypeUrl} alt="" width={48} height={48} />
          <img class="brand-wordmark" src={argvusWordmarkUrl} alt="ARGVUS" width={178} height={20} />
          {isBeta && <span class="beta-badge">Beta</span>}
        </a>
        <nav class="site-nav" aria-label="Main navigation" data-i18n-aria="navAria" data-site-nav>
          <div class="nav-links" id="site-nav-links">
            <a class="nav-link" href="https://argvus.github.io/docs/introduction/"><i class="fa-solid fa-book-open"></i><span data-i18n="documentation">Documentation</span></a>
            <div class="nav-dropdown" data-nav-dropdown>
              <button class="nav-link nav-dropdown-trigger" type="button" data-nav-dropdown-trigger>
                <i class="fa-solid fa-cube"></i>
                <span data-i18n="repository">Repository</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <div class="nav-dropdown-menu" data-nav-dropdown-menu hidden>
                <a class="nav-dropdown-item" href={`${base}arch/`}><i class="fa-brands fa-linux"></i><span data-i18n="archLinux">Arch Linux</span></a>
              </div>
            </div>
            <a class="nav-link" href={githubOrgUrl}><i class="fa-brands fa-github"></i><span data-i18n="github">GitHub</span></a>
            {contributionEnabled && <a class="nav-link nav-link-donate" href="https://argvus.github.io/#support"><i class="fa-solid fa-heart"></i><span data-i18n="donate">Donate</span></a>}
          </div>
          <div class="lang-toggle" data-lang-toggle>
            <button
              class="lang-toggle-btn"
              type="button"
              data-lang-current
              aria-label="Change language"
              data-i18n-aria="languageAria"
              aria-haspopup="menu"
            >
              <span data-language-current>EN</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>

            <div class="lang-toggle-menu" data-lang-menu hidden>
              <button class="lang-option" type="button" data-language-option="en" aria-current="page">English</button>
              <button class="lang-option" type="button" data-language-option="pt">Português</button>
            </div>
          </div>
          <ThemeToggle />
          <button class="nav-menu-btn" type="button" aria-controls="site-nav-links" aria-expanded="false" aria-label="Menu" data-i18n-aria="navMenu" data-nav-menu>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <a class="brand" href="https://argvus.github.io/">
              <img class="brand-logotype" src={logotypeUrl} alt="" width={48} height={48} />
              <img class="brand-wordmark" src={argvusWordmarkUrl} alt="ARGVUS" width={178} height={20} />
            </a>
            <p data-i18n="footerTagline">Official package repositories for the ARGVUS desktop environment.</p>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footerRepositories">Repositories</h4>
            <ul><li><a href={`${base}arch/`} data-i18n="archLinuxRepository">Arch Linux Repository</a></li></ul>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footerResources">Resources</h4>
            <ul>
              <li><a href="https://argvus.github.io/docs/introduction/" data-i18n="documentation">Documentation</a></li>
              <li><a href={githubOrgUrl} data-i18n="github">GitHub</a></li>
              <li><a href="https://argvus.github.io/" data-i18n="footerHome">Home</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footerCommunity">Community</h4>
            <ul>
              <li><a href="https://t.me/argvusdesktop" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-telegram"></i><span data-i18n="footerOfficialChannel">Official channel</span></a></li>
              <li><a href="https://t.me/argvuscommunity" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-telegram"></i><span data-i18n="footerGlobalCommunity">Global community</span></a></li>
              <li><a href="https://t.me/argvuscommunity_br" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-telegram"></i><span data-i18n="footerBrazilCommunity">Brazilian community</span></a></li>
            </ul>
          </div>
        </div>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} ARGVUS</span><span aria-hidden="true">·</span>
          <a href="https://github.com/argvus/argvus/blob/main/LICENSE" data-i18n="footerLicense">Licensed under GPL-3.0</a><span aria-hidden="true">·</span>
          <a href="https://github.com/williamcanin" target="_blank" rel="noopener noreferrer" data-i18n="footerMaintainer">Maintained by William C. Canin</a>
          <span class="footer-feedback" data-i18n="packagesHosted">Packages hosted on GitHub Pages</span>
        </div>
      </div>
    </footer>

    <script>
      const STORAGE_KEY = 'starlight-theme'
      const root = document.documentElement
      const media = window.matchMedia('(prefers-color-scheme: light)')
      const btn = document.querySelector('[data-theme-current]')
      const menu = document.querySelector('[data-theme-menu]')
      const options = Array.from(document.querySelectorAll('[data-theme-option]'))
      const langBtn = document.querySelector('[data-lang-current]')
      const langMenu = document.querySelector('[data-lang-menu]')
      const languageCurrent = document.querySelector('[data-language-current]')
      const languageOptions = Array.from(document.querySelectorAll('[data-language-option]'))
      const siteNav = document.querySelector('[data-site-nav]')
      const mobileButton = document.querySelector('[data-nav-menu]')
      const languageTranslations = {
        en: {
          documentation: 'Documentation',
          navAria: 'Main navigation',
          repository: 'Repository',
          archLinux: 'Arch Linux',
          github: 'GitHub',
          donate: 'Donate',
          packagesHosted: 'Packages hosted on GitHub Pages',
          footerTagline: 'Official package repositories for the ARGVUS desktop environment.',
          footerRepositories: 'Repositories',
          archLinuxRepository: 'Arch Linux Repository',
          footerResources: 'Resources',
          footerHome: 'Home',
          footerCommunity: 'Community',
          footerOfficialChannel: 'Official channel',
          footerGlobalCommunity: 'Global community',
          footerBrazilCommunity: 'Brazilian community',
          footerLicense: 'Licensed under GPL-3.0',
          footerMaintainer: 'Maintained by William C. Canin',
          navMenu: 'Menu',
          themeAria: 'Change theme',
          languageAria: 'Change language',
          themeLight: 'Light',
          themeDark: 'Dark',
          themeSystem: 'System',
          packageRepositories: 'Package repositories',
          rootIndex: 'Index of /packages/',
          rootLead: 'Browse the official ARGVUS Arch Linux repository, including signed packages and pacman databases.',
          name: 'Name',
          lastModified: 'Last modified',
          size: 'Size',
          argvusPackages: 'Argvus Packages',
          directoryLead: 'Browse package files directly, including pacman databases, signatures and binary package archives.',
        },
        pt: {
          documentation: 'Documentação',
          navAria: 'Navegação principal',
          repository: 'Repositório',
          archLinux: 'Arch Linux',
          github: 'GitHub',
          donate: 'Apoiar',
          packagesHosted: 'Pacotes hospedados no GitHub Pages',
          footerTagline: 'Repositórios oficiais de pacotes do ambiente de desktop ARGVUS.',
          footerRepositories: 'Repositórios',
          archLinuxRepository: 'Repositório Arch Linux',
          footerResources: 'Recursos',
          footerHome: 'Início',
          footerCommunity: 'Comunidade',
          footerOfficialChannel: 'Canal oficial',
          footerGlobalCommunity: 'Comunidade global',
          footerBrazilCommunity: 'Comunidade brasileira',
          footerLicense: 'Licenciado sob GPL-3.0',
          footerMaintainer: 'Mantido por William C. Canin',
          navMenu: 'Menu',
          themeAria: 'Alterar tema',
          languageAria: 'Alterar idioma',
          themeLight: 'Claro',
          themeDark: 'Escuro',
          themeSystem: 'Sistema',
          packageRepositories: 'Repositórios de pacotes',
          rootIndex: 'Índice de /packages/',
          rootLead: 'Navegue pelo repositório oficial do ARGVUS para Arch Linux, com pacotes assinados e bases do pacman.',
          name: 'Nome',
          lastModified: 'Última modificação',
          size: 'Tamanho',
          argvusPackages: 'Pacotes Argvus',
          directoryLead: 'Navegue diretamente pelos arquivos de pacotes, incluindo bancos de dados do pacman, assinaturas e arquivos binários de pacotes.',
        },
      }
      const LANGUAGE_KEY = 'argvus-packages-language'

      const currentTheme = () => {
        const stored = localStorage.getItem(STORAGE_KEY)
        return stored === 'light' || stored === 'dark'
          ? stored
          : media.matches
            ? 'light'
            : 'dark'
      }

      const render = () => {
        const theme = currentTheme()
        root.dataset.theme = theme
        btn.dataset.mode = localStorage.getItem(STORAGE_KEY) ? theme : 'system'
        options.forEach((opt) => {
          opt.setAttribute('aria-checked', String(opt.dataset.themeOption === theme))
        })
      }

      const setTheme = (value) => {
        if (value === 'system') localStorage.removeItem(STORAGE_KEY)
        else localStorage.setItem(STORAGE_KEY, value)
        render()
      }

      const currentLanguage = () => {
        const stored = localStorage.getItem(LANGUAGE_KEY)
        if (stored === 'en' || stored === 'pt') return stored
        return navigator.language.toLowerCase().startsWith('pt') ? 'pt' : 'en'
      }

      const setLanguage = (language) => {
        const translations = languageTranslations[language]
        localStorage.setItem(LANGUAGE_KEY, language)
        document.documentElement.lang = language === 'pt' ? 'pt-BR' : 'en'
        document.title = document.documentElement.dataset[`title${language === 'pt' ? 'Pt' : 'En'}`]
        document.querySelector('[data-page-description]').content =
          document.documentElement.dataset[`description${language === 'pt' ? 'Pt' : 'En'}`]
        languageCurrent.textContent = language.toUpperCase()
        languageOptions.forEach((option) => {
          option.setAttribute('aria-current', String(option.dataset.languageOption === language))
        })
        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const key = element.dataset.i18n
          element.textContent = key === 'directoryIndex'
            ? `${language === 'pt' ? 'Índice de' : 'Index of'} ${element.dataset.directoryPath}`
            : translations[key]
        })
        document.querySelectorAll('[data-i18n-aria]').forEach((element) => {
          element.setAttribute('aria-label', translations[element.dataset.i18nAria])
        })
      }

      btn.addEventListener('click', () => {
        menu.hidden = !menu.hidden
        langMenu.hidden = true
      })

      languageOptions.forEach((option) => {
        option.addEventListener('click', () => {
          setLanguage(option.dataset.languageOption)
          langMenu.hidden = true
        })
      })

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          setTheme(opt.dataset.themeOption)
          menu.hidden = true
        })
      })

      langBtn.addEventListener('click', () => {
        langMenu.hidden = !langMenu.hidden
        menu.hidden = true
      })

      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-theme-toggle]')) menu.hidden = true
        if (!e.target.closest('[data-lang-toggle]')) langMenu.hidden = true
        if (!e.target.closest('#site-nav-links') && !e.target.closest('[data-nav-menu]')) setMobileMenu(false)
        if (!e.target.closest('[data-nav-dropdown]')) {
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((dropdownMenu) => {
            dropdownMenu.hidden = true
          })
        }
      })

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          menu.hidden = true
          langMenu.hidden = true
          setMobileMenu(false)
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((dropdownMenu) => {
            dropdownMenu.hidden = true
          })
        }
      })

      document.querySelectorAll('[data-nav-dropdown-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation()
          const dropdownMenu = trigger.nextElementSibling
          dropdownMenu.hidden = !dropdownMenu.hidden
        })
      })

      const setMobileMenu = (open) => {
        siteNav.toggleAttribute('data-menu-open', open)
        mobileButton.setAttribute('aria-expanded', String(open))
      }
      mobileButton.addEventListener('click', (event) => {
        event.stopPropagation()
        setMobileMenu(!siteNav.hasAttribute('data-menu-open'))
      })
      siteNav.querySelectorAll('.nav-links a').forEach((anchor) => {
        anchor.addEventListener('click', () => setMobileMenu(false))
      })
      const header = document.querySelector('.site-header')
      const markScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 8)
      window.addEventListener('scroll', markScrolled, { passive: true })
      markScrolled()

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const hasHoverPointer = window.matchMedia('(hover: hover)').matches
      if (hasHoverPointer && !reduceMotion) {
        document.body.addEventListener('pointermove', (event) => {
          document.body.style.setProperty('--pointer-x', `${event.clientX}px`)
          document.body.style.setProperty('--pointer-y', `${event.clientY}px`)
        })
        document.querySelectorAll('.packages-hero').forEach((hero) => {
          hero.addEventListener('pointermove', (event) => {
            const rect = hero.getBoundingClientRect()
            hero.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width - 0.5).toFixed(3)}`)
            hero.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height - 0.5).toFixed(3)}`)
          })
        })
      }

      media.addEventListener('change', render)
      render()
      setLanguage(currentLanguage())
    </script>
  </body>
</html>
