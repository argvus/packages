---
import ThemeToggle from '../components/ThemeToggle.astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Signed Arch Linux package repository for Argvus, the complete Hyprland and Wayland desktop with official component packages.',
} = Astro.props
const base = import.meta.env.BASE_URL
const siteUrl = 'https://argvus.github.io'
const pageUrl = Astro.url.href
const githubOrgUrl = 'https://github.com/orgs/argvus'
const logotypeUrl =
  'https://raw.githubusercontent.com/argvus/argvus-logo/refs/heads/main/svg/logotype.svg'
const argvusWordmarkUrl =
  'https://raw.githubusercontent.com/argvus/argvus-logo/refs/heads/main/svg/argvus-text.svg'
const keywords =
  'argvus, argvus linux, hyprland, wayland, arch linux packages, pacman repository, argvus-appearance, argvus-greeter, argvus-session, argvus-storage, signed packages, linux desktop'
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Argvus Packages" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${siteUrl}${base}favicon.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${base}favicon.png`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'DataCatalog',
      name: 'Argvus Packages',
      url: pageUrl,
      description,
      keywords,
      creator: {
        '@type': 'Organization',
        name: 'Argvus',
        url: githubOrgUrl,
      },
    })} />
    <script is:inline>
      ;(function () {
        var key = 'starlight-theme'
        var stored = localStorage.getItem(key)
        var light = matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : light
              ? 'light'
              : 'dark'
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="https://argvus.github.io/">
          <img class="brand-logotype" src={logotypeUrl} alt="" width={48} height={48} />
          <img class="brand-wordmark" src={argvusWordmarkUrl} alt="ARGVUS" width={178} height={20} />
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <div class="nav-links">
            <a class="nav-link" href="https://argvus.github.io/docs/intro/">Documentation</a>
            <a class="nav-link" href={`${base}arch/`}>Arch repository</a>
            <a class="nav-link" href={githubOrgUrl}>GitHub</a>
          </div>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Argvus</span>
          <span>Packages hosted on GitHub Pages</span>
        </div>
      </div>
    </footer>

    <script>
      const STORAGE_KEY = 'starlight-theme'
      const root = document.documentElement
      const media = window.matchMedia('(prefers-color-scheme: light)')
      const btn = document.querySelector('[data-theme-current]')
      const menu = document.querySelector('[data-theme-menu]')
      const options = Array.from(document.querySelectorAll('[data-theme-option]'))

      const currentTheme = () => {
        const stored = localStorage.getItem(STORAGE_KEY)
        return stored === 'light' || stored === 'dark'
          ? stored
          : media.matches
            ? 'light'
            : 'dark'
      }

      const render = () => {
        const theme = currentTheme()
        root.dataset.theme = theme
        btn.dataset.mode = localStorage.getItem(STORAGE_KEY) ? theme : 'system'
        options.forEach((opt) => {
          opt.setAttribute('aria-checked', String(opt.dataset.themeOption === theme))
        })
      }

      const setTheme = (value) => {
        if (value === 'system') localStorage.removeItem(STORAGE_KEY)
        else localStorage.setItem(STORAGE_KEY, value)
        render()
      }

      btn.addEventListener('click', () => {
        menu.hidden = !menu.hidden
      })

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          setTheme(opt.dataset.themeOption)
          menu.hidden = true
        })
      })

      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-theme-toggle]')) menu.hidden = true
      })

      media.addEventListener('change', render)
      render()
    </script>
  </body>
</html>
